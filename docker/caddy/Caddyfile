# TLS termination for the production stack.
#
# Caddyfile comments are '#'. '//' is not a comment here -- it parses as a site
# address and makes the whole file invalid, which stops Caddy from starting at all.
#
# Caddy obtains and renews Let's Encrypt certificates automatically for the two
# domains below -- both must already resolve to this host's public IP, and ports
# 80/443 must be reachable from the internet for the ACME HTTP challenge.
#
# It also sets X-Forwarded-For / X-Forwarded-Proto, which the services read via
# AddReverseProxyForwardedHeaders(). Without TLS here, Production-mode auth
# cookies (Secure=true) are rejected by browsers and login silently fails.
{
	email {$ACME_EMAIL}

	# Which ACME directory to request certificates from. Defaults to Let's Encrypt
	# production. Set ACME_CA to the staging directory for a dry run:
	#
	#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
	#
	# Staging issues an untrusted certificate (browsers and curl will complain,
	# which is expected) but exercises the exact same DNS + port-80 challenge path
	# against far looser rate limits. Production allows only 5 failed validations
	# per account per hour, which is easy to burn through while a DNS record is
	# still wrong -- and once burned you are locked out for an hour. Rehearse on
	# staging, then clear ACME_CA and bring the stack up again for a real
	# certificate. Caddy keeps staging and production certs in separate storage
	# paths, so switching back re-issues cleanly.
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

# SPA
{$PUBLIC_WEB_DOMAIN} {
	encode gzip zstd

	reverse_proxy frontend:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# API gateway -- the only backend entry point. Individual microservices are not
# published to the host at all in docker-compose.prod.yml, so the org-scoping and
# rate limiting the gateway applies cannot be bypassed.
{$PUBLIC_API_DOMAIN} {
	encode gzip zstd

	reverse_proxy gateway-api:8080 {
		# SignalR websocket upgrade for /hubs/notifications
		header_up Host {upstream_hostport}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
