# Copy this file to .env and fill in the values before running docker-compose.
# Never commit the real .env to version control.

# ---- Environment ----
# Leave as Development for local docker-compose runs. Set to Production when
# deploying to a real server -- this flips on the insecure-default guards in
# each service's Program.cs (they refuse to start with a placeholder secret).
ASPNETCORE_ENVIRONMENT=Development

# ---- JWT ----
JWT_SECRET=change-me-minimum-32-chars-long-secret-key
JWT_ISSUER=BitirmeProject.IdentityService
JWT_AUDIENCE=BitirmeProject.Clients

# ---- RabbitMQ ----
RABBITMQ_USER=admin
RABBITMQ_PASS=change-me-rabbitmq-password

# ---- Redis ----
REDIS_PASS=change-me-redis-password

# ---- Database passwords ----
IDENTITY_DB_PASS=change-me-identity-db-password
PROJECT_DB_PASS=change-me-project-db-password
ISSUE_DB_PASS=change-me-issue-db-password
SPRINT_DB_PASS=change-me-sprint-db-password
NOTIFICATION_DB_PASS=change-me-notification-db-password
STORAGE_DB_PASS=change-me-storage-db-password
AI_DB_PASS=change-me-ai-db-password

# ---- Internal service-to-service API key ----
# Shared secret issue/sprint/ai services use to authenticate calls from each
# other (see InternalServiceMiddleware). Must be identical across all three.
INTERNAL_SERVICE_API_KEY=change-me-internal-service-key

# ---- Admin seeder ----
SEED_ADMIN=true
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin

# ---- Public addresses ----
# Leave both unset for a local run; localhost defaults apply.
# Set them when the stack runs on a different machine than the browser, using
# that machine's address (e.g. http://192.168.0.107:5000). VITE_API_BASE_URL is
# resolved by the browser, so "localhost" would point at the client, not the host.
# PUBLIC_WEB_ORIGIN must match PUBLIC_API_BASE_URL's host or the gateway blocks
# the request via CORS -- it allows credentials, so the origin list is strict.
PUBLIC_API_BASE_URL=http://localhost:5000
PUBLIC_WEB_ORIGIN=http://localhost:5174

# ---- Ollama ----
# On Linux Docker hosts, set to http://host.docker.internal:11434 (extra_hosts maps this automatically)
# On Windows/Mac Docker Desktop, the default works without changes
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- AI Fine-tune (tools/ai-finetune + tools/ai-data-collector) ----
# Groq free-tier key used by tools/ai-data-collector for synthetic data generation (llama-3.3-70b-versatile).
# Obtain from https://console.groq.com (free). Leave empty if you run synthetic generation fully on local Ollama.
GROQ_API_KEY=
# Hugging Face token for optional adapter push to HF Hub free tier. Not required for local Colab-only flow.
HF_TOKEN=
